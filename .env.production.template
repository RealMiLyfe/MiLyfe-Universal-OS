# ═══════════════════════════════════════════════════════════
# MiLyfe Platform — Production Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables
# DO NOT fill in real values here — this is a TEMPLATE
# ═══════════════════════════════════════════════════════════

# ── Supabase (REQUIRED) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── AI / LLM (for Mi AI agent) ──
GROQ_API_KEY=<get-from-groq.com-free-tier>

# ── Upstash Redis (rate limiting, caching, queues) ──
UPSTASH_REDIS_REST_URL=<get-from-upstash.com-free-tier>
UPSTASH_REDIS_REST_TOKEN=<get-from-upstash.com>
QSTASH_TOKEN=<get-from-upstash.com-qstash>

# ── Email (Resend) ──
RESEND_API_KEY=<get-from-resend.com-free-tier>

# ── Push Notifications (VAPID — generate your own) ──
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>

# ── Error Tracking (Sentry) ──
SENTRY_DSN=<get-from-sentry.io-free-tier>
NEXT_PUBLIC_SENTRY_DSN=<same-as-above>
SENTRY_AUTH_TOKEN=<sentry-auth-token-for-source-maps>

# ── Analytics (PostHog) ──
NEXT_PUBLIC_POSTHOG_KEY=<get-from-posthog.com-free-tier>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── LiveKit (video/audio rooms) ──
LIVEKIT_URL=<get-from-livekit.io-cloud-free>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>

# ── Internal / Cron ──
CRON_SECRET=<generate-with-openssl-rand-hex-32>
