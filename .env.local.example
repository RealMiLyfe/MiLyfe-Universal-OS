# MiLyfe Platform — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local — it's gitignored

# ─── Supabase (Required) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron Jobs (Required for UBI/decay/proposals to run) ───────────────────
CRON_SECRET=generate-a-random-string-here

# ─── AI / Mi Chat (Optional — Mi won't work without these) ────────────────
OPENAI_API_KEY=your-openai-or-groq-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
MI_MODEL=gpt-4o-mini

# ─── Rate Limiting (Optional — falls back to in-memory without these) ──────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Observability (Optional) ──────────────────────────────────────────────
# Minimum log level: debug | info | warn | error
# Defaults to 'info' in production, 'debug' otherwise.
LOG_LEVEL=info
# Wire an error tracker (e.g. Sentry/GlitchTip) via registerErrorSink() at
# startup. DSN is only read by your sink setup, not by the logger itself.
# SENTRY_DSN=
